# Copy to .env.infra. Never commit filled secrets.
# Use the same values in Dokploy app and worker environment.

# PostgreSQL
PG_DATABASE_NAME=default
PG_DATABASE_USER=postgres
# Generate: openssl rand -hex 32
PG_DATABASE_PASSWORD=replace-with-64-hex-characters

# Redis
# Generate: openssl rand -hex 32
REDIS_PASSWORD=replace-with-64-hex-characters
