# App environment for Dokploy heycrm-server and heycrm-worker.
# Set same values on both apps. Never commit filled secrets.
# Hostnames assume both apps and infra join Dokploy network `dokploy-network`.

# PostgreSQL from docker-compose.infra.yml
PG_DATABASE_URL=postgres://postgres:replace-with-64-hex-characters@postgres:5432/default

# Redis from docker-compose.infra.yml
REDIS_URL=redis://:replace-with-64-hex-characters@redis:6379

# Public URLs
SERVER_URL=https://crm.example.com
FRONTEND_URL=https://crm.example.com

# Required secrets. Generate each with: openssl rand -hex 32
APP_SECRET=replace-with-64-hex-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
FALLBACK_ENCRYPTION_KEY=

PRODUCT_NAME=HeyCRM
PRODUCT_LOGO_URL=
PRODUCT_FAVICON_URL=

# Multi-workspace. Route *.example.com to same Dokploy server.
IS_MULTIWORKSPACE_ENABLED=true
DEFAULT_SUBDOMAIN=app
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false

# Production file storage. Replace values with your S3-compatible provider.
STORAGE_TYPE=s3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_NAME=replace-with-bucket-name
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=replace-with-access-key
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-secret-key
STORAGE_S3_PRESIGNED_URL_ENABLED=false

# heycrm-worker only. Keep these true on worker; false/default on server.
# DISABLE_DB_MIGRATIONS=true
# DISABLE_CRON_JOBS_REGISTRATION=true

# Optional email.
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=contact@example.com
# EMAIL_FROM_NAME=HeyCRM
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
